<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ASHSDKRoot Condition="'$(ASHSDKRoot)'==''">$(MSBuildThisFileDirectory)..\</ASHSDKRoot>
    <ASHSDKLibrary>$(ASHSDKRoot)lib\$(Platform)\Release\ash-core.lib</ASHSDKLibrary>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ASHSDKRoot)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <ForcedIncludeFiles>ash/Version.hpp;%(ForcedIncludeFiles)</ForcedIncludeFiles>
    </ClCompile>
    <Link>
      <AdditionalDependencies>$(ASHSDKLibrary);%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
